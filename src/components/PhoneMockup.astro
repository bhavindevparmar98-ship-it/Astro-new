---
import { Image } from 'astro:assets';

interface Props {
  screenSrc?: any;
  width?: number;
  height?: number;
}

const { screenSrc, width = 280, height = 560 } = Astro.props;
---

<div class="phone-mockup" style={`width: ${width}px; height: ${height}px;`}>
  <div class="phone-screen">
    <div class="phone-notch"></div>
    {screenSrc && (
      typeof screenSrc === 'string' ? (
        <img src={screenSrc} alt="App preview" class="screen-image" />
      ) : (
        <Image src={screenSrc} alt="App preview" class="screen-image" />
      )
    )}
  </div>
</div>

<style>
  .phone-mockup {
    padding: 10px;
    border: 8px solid #231f20;
    border-radius: 42px;
    background: #ffffff;
    box-sizing: border-box;
    margin-inline: auto;
    box-shadow: 0 16px 32px rgba(35, 31, 32, 0.08);
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: 30px;
    background: #f4f4f4;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .screen-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phone-notch {
    width: 90px;
    height: 22px;
    background: #231f20;
    border-radius: 0 0 14px 14px;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  @media (max-width: 767px) {
    .phone-mockup {
      width: 220px !important;
      height: 440px !important;
    }
  }
</style>