---
import '../components/styles.astro/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>About Savio</title>
  </head>
  <body class="about-page">
    <div class="page-shell">
      <header class="site-header">
        <div class="container container-1110 topbar-wrap">
          <div class="brand-wrap">
            <div class="brand-mark">S</div>
            <span class="brand-text">savio</span>
          </div>

          <nav class="main-nav" aria-label="Main navigation">
            <a href="#story">Features</a>
            <a href="#vision">How it works</a>
            <a href="#values">App</a>
            <a href="#team">Testimonials</a>
          </nav>

          <a class="btn btn-primary" href="#contact">Signup</a>
        </div>
      </header>

      <main class="about-main">
        <section class="hero-section section-padding-96">
          <div class="container container-1110 hero-grid">
            <div class="hero-copy">
              <span class="eyebrow">About Savio</span>
              <h1>Why we built <span>Savio.</span></h1>
              <p class="hero-text">
                Reels in Instagram, videos in YouTube, threads in X, links in a dozen notes — all bookmarked with the best intentions, none of them ever seen again. So we built a calmer way.
              </p>

              <div class="store-row">
                <a class="store-badge app-store" href="#contact">
                  <span class="app-icon"></span>
                  <span>
                    <small>Download on the</small>
                    <strong>App Store</strong>
                  </span>
                </a>
                <a class="store-badge play-store" href="#contact">
                  <span class="app-icon">▶</span>
                  <span>
                    <small>GET IT ON</small>
                    <strong>Google Play</strong>
                  </span>
                </a>
              </div>
            </div>

            <div class="hero-visual">
              <div class="phone-shell">
                <div class="phone-topbar">
                  <span class="camera"></span>
                  <span class="signal">▣</span>
                  <span class="signal">◐</span>
                </div>

                <div class="screen-header">
                  <span class="play-pill">▶</span>
                  <span class="time">12:30</span>
                  <div class="status-icons">
                    <span>◔</span>
                    <span>◍</span>
                    <span>◉</span>
                  </div>
                </div>

                <div class="mini-app-card main-cta">
                  <div class="mini-card-header">
                    <span class="brand-mini">savio</span>
                    <div class="user-stack">
                      <span>18</span>
                    </div>
                  </div>

                  <div class="share-box">
                    <div class="share-head">
                      <div class="avatars">
                        <span class="a1">A</span>
                        <span class="a2">M</span>
                        <span class="a3">S</span>
                      </div>
                      <span class="share-label">Share with friends</span>
                    </div>

                    <div class="share-row">
                      <div class="share-copy">
                        <strong>What you have been saving now</strong>
                        <span>Apr 2026</span>
                      </div>
                      <button class="pill-button">Share</button>
                    </div>
                  </div>

                  <button class="watch-button">Watch Today’s Digest</button>
                </div>

                <div class="mini-card saved-card">
                  <div class="saved-icon">🛡</div>
                  <div class="saved-copy">
                    <strong>Recently saved</strong>
                    <span>What can I do to make this easier?</span>
                  </div>
                </div>
              </div>

              <div class="floating-badge">
                <span class="badge-label">🔔</span>
                <strong>1</strong>
              </div>
            </div>
          </div>
        </section>

        <section id="story" class="story-section section-padding-80">
          <div class="container container-1110 story-grid">
            <div class="story-copy">
              <span class="eyebrow">Our story</span>
              <h2 class="heading-h2 text-primary">We made the complex feel simple.</h2>
              <p class="para-large text-light-70">
                Savio started with a simple idea: modern teams should not have to stitch together scattered tools just to operate effectively.
              </p>
              <p class="para-regular text-light-70">
                We designed Savio to deliver a unified experience for planning, reporting, execution, and customer-facing work—so every team can align around one clear source of truth.
              </p>
            </div>

            <div class="story-image-wrap">
              <div class="media-placeholder tall-placeholder">
                <span>Product image</span>
              </div>
            </div>
          </div>
        </section>

        <section id="vision" class="values-section section-padding-80 bg-grey">
          <div class="container container-1110">
            <div class="section-head">
              <span class="eyebrow">Vision</span>
              <h2 class="heading-h2 text-primary">A smarter way to scale work.</h2>
            </div>

            <div class="value-grid">
              <article class="value-card">
                <div class="card-number">01</div>
                <h3 class="heading-h5 text-primary">Clarity</h3>
                <p class="para-regular text-light-70">See what matters with clean, actionable data and shared visibility across the business.</p>
              </article>

              <article class="value-card">
                <div class="card-number">02</div>
                <h3 class="heading-h5 text-primary">Speed</h3>
                <p class="para-regular text-light-70">Automate the routine, connect the teams, and ship initiatives without unnecessary friction.</p>
              </article>

              <article class="value-card">
                <div class="card-number">03</div>
                <h3 class="heading-h5 text-primary">Trust</h3>
                <p class="para-regular text-light-70">Build resilient workflows that are transparent, measurable, and easy for teams to rely on.</p>
              </article>
            </div>
          </div>
        </section>

        <section id="values" class="principles-section section-padding-80">
          <div class="container container-1110">
            <div class="section-head center-head">
              <span class="eyebrow">Why teams choose Savio</span>
              <h2 class="heading-h2 text-primary">Every workflow built around outcomes.</h2>
            </div>

            <div class="principles-grid">
              <div class="principle-box">
                <div class="icon-box">A</div>
                <div>
                  <h3 class="heading-h6 text-primary">A single system of action</h3>
                  <p class="para-regular text-light-70">Replace fragmented tools with one connected operating layer.</p>
                </div>
              </div>

              <div class="principle-box">
                <div class="icon-box">B</div>
                <div>
                  <h3 class="heading-h6 text-primary">Better collaboration</h3>
                  <p class="para-regular text-light-70">Keep teams aligned with shared context and clearer decisions.</p>
                </div>
              </div>

              <div class="principle-box">
                <div class="icon-box">C</div>
                <div>
                  <h3 class="heading-h6 text-primary">Growth without friction</h3>
                  <p class="para-regular text-light-70">Scale routines, reporting, and experiments without operational drag.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="team" class="team-section section-padding-80 bg-primary">
          <div class="container container-1110">
            <div class="section-head team-head">
              <span class="eyebrow light">Leadership</span>
              <h2 class="heading-h2 text-white">The people behind the platform.</h2>
            </div>

            <div class="team-grid">
              <article class="team-card">
                <div class="team-avatar avatar-one">AR</div>
                <h3 class="heading-h6 text-white">Ana Ross</h3>
                <p class="para-regular text-white-70">Product Lead</p>
              </article>

              <article class="team-card">
                <div class="team-avatar avatar-two">MK</div>
                <h3 class="heading-h6 text-white">Mike Kline</h3>
                <p class="para-regular text-white-70">Design Director</p>
              </article>

              <article class="team-card">
                <div class="team-avatar avatar-three">SL</div>
                <h3 class="heading-h6 text-white">Sara Lee</h3>
                <p class="para-regular text-white-70">Growth Strategy</p>
              </article>
            </div>
          </div>
        </section>
      </main>

      <footer id="contact" class="site-footer">
        <div class="container container-1110 footer-wrap">
          <div>
            <div class="brand-wrap footer-brand">
              <div class="brand-mark">S</div>
              <span class="brand-text text-white">Savio</span>
            </div>
            <p class="para-regular text-white-70">Helping teams move from ideas to measurable outcomes.</p>
          </div>

          <div class="footer-links">
            <a href="#story">Our story</a>
            <a href="#vision">Vision</a>
            <a href="#values">Values</a>
            <a href="#team">Team</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
