<script>
  // ---------- Mobile navbar ----------
  const navbar = document.querySelector<HTMLElement>(".navbar");
  const toggle = navbar?.querySelector<HTMLButtonElement>(".nav-toggle");
  const links = navbar?.querySelector<HTMLElement>(".nav-links");

  function setMenu(open: boolean) {
    navbar?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  }

  toggle?.addEventListener("click", () => {
    setMenu(!navbar?.classList.contains("is-open"));
  });

  links?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && navbar?.classList.contains("is-open")) {
      setMenu(false);
      toggle?.focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (navbar && !navbar.contains(e.target as Node)) setMenu(false);
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  // ---------- FAQ accordion ----------
  const ONE_AT_A_TIME = true; // false = each item opens/closes independently
  const items = document.querySelectorAll<HTMLElement>(".faq-item");

  function setFaq(item: HTMLElement, open: boolean) {
    item.classList.toggle("open", open);
    const row = item.querySelector(".faq-question-row");
    const sign = item.querySelector(".faq-toggle");
    row?.setAttribute("aria-expanded", String(open));
    if (sign) sign.textContent = open ? "−" : "+";
  }

  items.forEach((item) => {
    const row = item.querySelector<HTMLElement>(".faq-question-row");

    const handle = () => {
      const willOpen = !item.classList.contains("open");
      if (ONE_AT_A_TIME && willOpen) {
        items.forEach((other) => setFaq(other, false));
      }
      setFaq(item, willOpen);
    };

    row?.addEventListener("click", handle);
    row?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        handle();
      }
    });
  });
</script>

<script>
  import Swiper from "swiper";
  import { Navigation, Autoplay } from "swiper/modules";
  import "swiper/css";

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const wrap = document.querySelector<HTMLElement>(".phone-swiper-wrap")!;

  // Figma: phone 229.49, gap 40 -> gap = 17.43% of phone width
  const GAP_RATIO = 0.1743;
  const FIGMA_W = 229.49;

  /**
   * Slider width = 2 * m * pitch  -> edge phones are exactly 50% cut.
   * m = phones on each side of the center one (tune here).
   */
  function layout() {
    const vw = window.innerWidth;
    const m = vw >= 1280 ? 3 : vw >= 768 ? 2 : 1;
    const max = m === 3 ? FIGMA_W : Infinity;
    const w = wrap.clientWidth;
    const slide = Math.min(max, w / (2 * m * (1 + GAP_RATIO)));
    wrap.style.setProperty("--slide-w", `${slide}px`);
    wrap.style.setProperty("--pitch", `${slide * (1 + GAP_RATIO)}px`);
  }
  layout();

  // markup has 3 identical copies -> N = real screens
  const TOTAL = document.querySelectorAll(".phone-swiper .swiper-slide").length;
  const N = TOTAL / 3;

  const dotsWrap = document.querySelector<HTMLElement>(".phone-pagination");
  const dots: HTMLButtonElement[] = Array.from({ length: N }, (_, i) => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "phone-dot";
    b.setAttribute("aria-label", `Go to screen ${i + 1}`);
    dotsWrap?.appendChild(b);
    return b;
  });

  const setActive = (index: number) => {
    dots.forEach((d, i) => d.classList.toggle("is-active", i === index % N));
  };

  const swiper = new Swiper(".phone-swiper", {
    modules: [Navigation, Autoplay],
    slidesPerView: "auto",
    centeredSlides: true, // center phone full, both edge phones 50% cut
    spaceBetween: 0, // gap is built into slide width (--pitch)
    loop: false,
    initialSlide: N, // start on the first screen of the MIDDLE copy
    grabCursor: true,
    speed: 700,
    autoplay: reduceMotion
      ? false
      : {
          delay: 2500,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
    navigation: {
      nextEl: ".phone-nav-next",
      prevEl: ".phone-nav-prev",
    },
    on: {
      init: (s) => setActive(s.activeIndex),
      slideChange: (s) => setActive(s.activeIndex),
      // after each move, silently jump back into the middle copy
      slideChangeTransitionEnd: (s) => {
        if (s.activeIndex < N) s.slideTo(s.activeIndex + N, 0, false);
        else if (s.activeIndex >= 2 * N) s.slideTo(s.activeIndex - N, 0, false);
      },
    },
  });

  // re-measure on any width change (resize, scrollbar, fonts, orientation)
  let raf = 0;
  new ResizeObserver(() => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      layout();
      swiper.update();
    });
  }).observe(wrap);

  window.addEventListener("load", () => {
    layout();
    swiper.update();
  });

  dots.forEach((d, i) =>
    d.addEventListener("click", () => {
      const base = Math.floor(swiper.activeIndex / N) * N;
      swiper.slideTo(base + i);
    }),
  );
</script>