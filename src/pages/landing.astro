<script>
  const navbar = document.querySelector<HTMLElement>('.navbar');
  const toggle = navbar?.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = navbar?.querySelector<HTMLElement>('.nav-links');

  function setMenu(open: boolean) {
    navbar?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  // hamburger click
  toggle?.addEventListener('click', () => {
    setMenu(!navbar?.classList.contains('is-open'));
  });

  // link click par menu band
  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });

  // Escape thi band + focus button par pacho
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navbar?.classList.contains('is-open')) {
      setMenu(false);
      toggle?.focus();
    }
  });

  // bahar click par band
  document.addEventListener('click', (e) => {
    if (navbar && !navbar.contains(e.target as Node)) setMenu(false);
  });

  // desktop size par jaao to reset
  window.matchMedia('(min-width: 1025px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>