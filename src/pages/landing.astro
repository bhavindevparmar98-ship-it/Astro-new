---
import { Image } from 'astro:assets';
import PhoneMockup from '../components/PhoneMockup.astro';
import '../components/styles.astro/global.css';
import appStoreBadge from '../assets/app-store-apple-logo.svg';
import googlePlayBadge from '../assets/google-play-badge-logo1.svg';
import phoneMockup from '../assets/iphone-15-pro-max-hand-mockup.png';
import heroVisual from '../assets/ab savio img.png';
import heroBg from '../assets/hero bg.png';
import frameImg1 from '../assets/Frame img-4.svg';
import frameImg3 from '../assets/Frame img-3.svg';
import frameImg4 from '../assets/frame-img-1.svg';
import frameImg5 from '../assets/Frame img-2.svg';
import appImg from '../assets/app.png';
import galleryImg3 from '../assets/gallery-img-3.png';
import galleryImg4 from '../assets/gallery-img-4.png';
import galleryImg5 from '../assets/gallery-img-5.png';
import galleryImg6 from '../assets/gallery-img-6.png';

const heroStats = [
  { value: '120K+', label: 'Active users' },
  { value: '4.9+', label: 'App Store rating' },
  { value: '8M+', label: 'Items saved' },
  { value: '8+', label: 'Platforms supported' },
];

const steps = [
  { step: 'STEP 01', title: 'Save', text: 'Share anything to Savio in a single tap.', icon: 'save' },
  { step: 'STEP 02', title: 'Organize', text: 'Drop it into a collection or let us suggest one.', icon: 'organize' },
  { step: 'STEP 03', title: 'Revisit', text: 'Get gentle reminders and your daily digest.', icon: 'remind' },
];

const testimonials = [
  { quote: 'Savio replaced 4 apps. My screenshots folder finally has peace.', name: 'Rhea S.', role: 'Product designer' },
  { quote: 'I save less and remember more. The reminder system feels calm, not noisy.', name: 'Miles D.', role: 'Writer' },
  { quote: 'The collections are clean, searchable, and actually useful every single day.', name: 'Preeti A.', role: 'Research lead' },
  { quote: 'It finally feels like a place for my internet life instead of a graveyard of tabs.', name: 'Aarav N.', role: 'Creator' },
];

const faqs = [
  {
    q: 'What is Savio and how is it different from bookmarks?',
    a: 'Savio is not just a place to dump links. It helps you save content with intention, organize it into collections, and come back to it with smart reminders so nothing important gets lost.',
    open: true,
  },
  { q: 'Does Savio store everything privately?', a: 'Yes. Savio is built to keep your saved content personal and private while still making it easy to revisit and share the things that matter.' },
  { q: 'Can I save from mobile apps and the web?', a: 'Absolutely. Savio works across popular apps and URLs so you can keep your saves in one place without extra effort.' },
  { q: 'Is it free to use?', a: 'Yes. Savio is free to download and use, with a calming, no-friction experience at the core of the product.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Savio landing page" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Savio | Landing Page</title>
  </head>
  <body>
    <div class="landing-shell">
      <header class="hero-header">
        <div class="hero-frame">
          <nav class="navbar" aria-label="Main navigation">
            <a href="/landing" class="brand-mark" aria-label="Savio home">
              <img src="/savio-logo.svg" alt="Savio logo" />
            </a>

            <div class="nav-links" id="nav-links">
              <a href="#features">Features</a>
              <a href="#how-it-works">How it works</a>
              <a href="#app">App</a>
              <a href="#testimonials">Testimonials</a>
            </div>

            <div class="nav-actions">
              <button type="button" class="cta-pill">Signup</button>
              <button
                type="button"
                class="nav-toggle"
                aria-expanded="false"
                aria-controls="nav-links"
                aria-label="Open menu"
              >
                <span></span><span></span><span></span>
              </button>
            </div>
          </nav>

          <div class="hero-content">
            <div class="hero-copy">
              <span class="eyebrow">SMART REMINDERS</span>
              <h1>
                Smart <span class="accent">Reminders.</span><br />
                Save what matters.
              </h1>
              <p>
                Savio turns endless scrolling into intentional saving so your best ideas, links,
                and moments are easy to revisit later.
              </p>

              <div class="store-row" aria-label="Download app badges">
                <Image src={appStoreBadge} alt="Download on the App Store" class="badge" width={161} height={48} />
                <Image src={googlePlayBadge} alt="Get it on Google Play" class="badge" width={161} height={48} />
              </div>
            </div>

            <div class="hero-visual" aria-label="Savio app preview">
              <div class="hero-phone-stack">
                <Image src={heroBg} alt="Savio app overview" class="hero-main-image" />
              </div>
            </div>
          </div>
        </div>
      </header>

      <main>
        <section class="stats-bar">
          <div class="stats-strip">
            {heroStats.map((item) => (
              <div class="stat-cell">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </section>

        <section class="features-section" id="features">
          <div class="section-head center">
            <span class="eyebrow eyebrow-dark">FEATURES</span>
            <h2>A calmer way to keep what you love.</h2>
          </div>

          <div class="feature-stack">
            <article class="feature-row">
              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">SAVE IN ONE TAP</span>
                <h3>From any app, straight to Savio.</h3>
                <p>Hit share, choose Savio, and keep your best links, clips, and ideas in one place without breaking flow.</p>
              </div>

              <div class="feature-visual visual-orange">
                <div class="phone-panel">
                  <Image src={frameImg1} alt="Feature phone preview" class="phone-panel-image" />
                </div>
              </div>
            </article>

            <article class="feature-row reverse">
              <div class="feature-visual visual-soft">
                <div class="phone-panel">
                  <Image src={frameImg3} alt="Feature phone preview" class="phone-panel-image" />
                </div>
              </div>

              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">ORGANIZE YOUR WORLD</span>
                <h3>Collections that actually feel yours.</h3>
                <p>Group saves by mood, topic, or intent with automatic organization that keeps things searchable and easy to revisit.</p>
              </div>
            </article>

            <article class="feature-row">
              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">DAILY DIGEST</span>
                <h3>Come back to what matters, gently.</h3>
                <p>Get a calm digest of content you saved with enough context to act quickly and enough spacing to stay relaxed.</p>
              </div>

              <div class="feature-visual visual-soft">
                <div class="phone-panel">
                  <Image src={frameImg4} alt="Feature phone preview" class="phone-panel-image" />
                </div>
              </div>
            </article>

            <article class="feature-row reverse">
              <div class="feature-visual visual-soft">
                <div class="phone-panel">
                  <Image src={frameImg5} alt="Feature phone preview" class="phone-panel-image" />
                </div>
              </div>

              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">SMART REMINDERS</span>
                <h3>The right save, at the right moment.</h3>
                <p>Savio knows when you are ready to watch, read, or revisit and gently brings it back at the ideal time.</p>
              </div>
            </article>
          </div>
        </section>

        <section class="how-section" id="how-it-works">
          <div class="how-section-head center">
            <span class="eyebrow">HOW IT WORKS</span>
            <h2>Three steps. Zero friction.</h2>
          </div>

          <div class="steps-strip">
            {steps.map((item) => (
              <div class="step-card">
                <div class="icon-box">
                  {item.icon === 'save' && <span>⇪</span>}
                  {item.icon === 'organize' && <span>▣</span>}
                  {item.icon === 'remind' && <span>◔</span>}
                </div>
                <div class="step-content">
                  <span class="step-label">{item.step}</span>
                <div class="step-text">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
                </div>              

              </div>
            ))}
          </div>
        </section>

        <section class="app-showcase" id="app">
          <div class="app-showcase-header center">
            <span class="eyebrow eyebrow-dark">THE APP</span>
            <h2>Designed with the same care you save with.</h2>
          </div>

          <div class="phone-row">
            {[heroVisual, appImg, galleryImg3, galleryImg4, galleryImg5, galleryImg6].map((screen, index) => (
              <div class={`app-phone${index === 0 ? ' phone-splash' : ''}`}>
                <PhoneMockup width={229} height={473} screenSrc={screen} />
              </div>
            ))}
          </div>
        </section>

        <section class="testimonial-section" id="testimonials">
          <div class="section-head center">
            <span class="eyebrow">LOVED BY QUIET READERS</span>
            <h2>Built for people, not for feeds.</h2>
          </div>

          <div class="marquee-wrap">
            <div class="marquee marquee-one">
              {[...testimonials, ...testimonials].map((item) => (
                <article class="testimonial-card">
                  <div class="stars" aria-label="5 star rating">★★★★★</div>
                  <p>“{item.quote}”</p>
                  <div class="person-row">
                    <span class="person-badge">{item.name.slice(0, 2).toUpperCase()}</span>
                    <div>
                      <strong>{item.name}</strong>
                      <span>{item.role}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
            <div class="marquee marquee-two">
              {[...testimonials, ...testimonials].map((item) => (
                <article class="testimonial-card">
                  <div class="stars" aria-label="5 star rating">★★★★★</div>
                  <p>“{item.quote}”</p>
                  <div class="person-row">
                    <span class="person-badge">{item.name.slice(0, 2).toUpperCase()}</span>
                    <div>
                      <strong>{item.name}</strong>
                      <span>{item.role}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="faq-section">
          <div class="faq-layout">
            <div class="faq-copy">
              <span class="eyebrow">FAQs</span>
              <h2>Frequently asked questions</h2>
            </div>

            <div class="faq-list">
              {faqs.map((item) => (
                <div class={`faq-item ${item.open ? 'open' : ''}`}>
                  <div class="faq-question-row">
                    <span>{item.q}</span>
                    <span class="faq-toggle">{item.open ? '−' : '+'}</span>
                  </div>
                  {item.open && <p>{item.a}</p>}
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="cta-section">
          <div class="cta-card">
            <div class="cta-copy">
              <span class="eyebrow">FREE TO DOWNLOAD</span>
              <h2>Your saved world, one tap away.</h2>
              <p>Free to download. Built for the people who like to revisit.</p>
              <div class="cta-social compact" aria-label="App downloads">
                <Image src={appStoreBadge} alt="Download on the App Store" class="badge small-badge" width={134} height={40} />
                <Image src={googlePlayBadge} alt="Get it on Google Play" class="badge small-badge" width={134} height={40} />
              </div>
            </div>

            <Image src={phoneMockup} alt="Savio phone mockup" class="cta-phone" />
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src="/savio-logo.svg" alt="Savio logo" />
          </div>

          <nav class="footer-links" aria-label="Footer navigation">
            <a href="#features">Features</a>
            <a href="#how-it-works">How it works</a>
            <a href="#app">App</a>
            <a href="#testimonials">Testimonials</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --orange: #ff4800;
    --text: #231f20;
    --muted-60: rgba(35, 31, 32, 0.6);
    --muted-70: rgba(35, 31, 32, 0.7);
    --muted-80: rgba(35, 31, 32, 0.8);
    --white: #fff;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: 'Cabin', system-ui, sans-serif;
    background: #ffffff;
    color: var(--text);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  img { display: block; max-width: 100%; }
  a { text-decoration: none; }
  button { font: inherit; }
  h1, h2, h3, p { margin: 0; }

  .landing-shell { width: 100%; background: #fff; overflow-x: hidden; }
  .hero-header { padding: 16px 16px 0; }

  /* ---------- HERO ---------- */
  .hero-frame {
    position: relative;
    width: 100%;
    margin: 0 auto;
    border-radius: 24px;
    background: linear-gradient(133deg, rgba(255,199,176,0.4) 0%, rgba(255,72,0,0.4) 94.86%);
    overflow: hidden;
    min-height: 992px;
    isolation: isolate;
  }

  .hero-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url('../assets/hero-box-bg.svg');
    background-repeat: no-repeat;
    background-position: center center;
    background-size: contain;
    z-index: 0;
    pointer-events: none;
  }

  /* ---------- NAVBAR ---------- */
  .navbar {
    position: relative;
    z-index: 10; /* hero-content (z-index 2) na upar dropdown dekhay */
    width: min(1110px, calc(100% - 64px));
    height: 72px;
    margin: 24px auto 0;
    padding: 0 20px 0 18px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(35, 31, 32, 0.1);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 104px;
    background: none;
  }
  .brand-mark img { width: auto; height: 32px; }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1;
  }

  .nav-links a {
    padding: 12px 16px;
    color: var(--muted-80);
    font-size: 16px;
    line-height: 19px;
    font-weight: 400;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cta-pill {
    border: none;
    background: var(--orange);
    color: var(--white);
    border-radius: 12px;
    width: 112px;
    height: 43px;
    cursor: pointer;
    font-weight: 500;
    font-size: 16px;
  }

  /* Desktop ma hamburger chhupavo */
  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle span {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: #231f20;
    transition: transform .25s ease, opacity .2s ease;
  }
  .nav-toggle span:nth-child(1) { top: 15px; }
  .nav-toggle span:nth-child(2) { top: 21px; }
  .nav-toggle span:nth-child(3) { top: 27px; }

  .navbar.is-open .nav-toggle span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .navbar.is-open .nav-toggle span:nth-child(2) { opacity: 0; }
  .navbar.is-open .nav-toggle span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  /* ---------- HERO CONTENT ---------- */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1110px;
    margin: 0 auto;
    padding: 48px 16px 0;
  }

  .hero-copy {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    font-size: 16px;
    line-height: 19px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .hero-copy h1 {
    font-size: clamp(3.2rem, 5vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.065em;
    font-weight: 700;
    color: var(--text);
  }

  .hero-copy h1 .accent { color: var(--orange); }

  .hero-copy p {
    margin: 22px auto 0;
    max-width: 760px;
    font-size: 20px;
    line-height: 1.35;
    color: var(--muted-60);
  }

  .store-row {
    margin-top: 32px;
    display: flex;
    gap: 16px;
    flex-direction: row;
    justify-content: center;
  }

  .badge {
    width: 161.34px;
    height: 48px;
    object-fit: cover;
  }

  .badge.small-badge {
    width: 134.45px;
    height: 40px;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    margin: 18px auto 0;
  }

  .hero-phone-stack {
    position: relative;
    width: min(954px, 100%);
    display: flex;
    margin: 0 auto;
  }

  .hero-main-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: cover;
    filter: drop-shadow(0 22px 24px rgba(35, 31, 32, 0.18));
  }

  /* ---------- SECTION WRAPPERS ---------- */
  .features-section {
    max-width: 1110px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    padding: 80px 0px;
}

  .how-section,
  .testimonial-section,
  .faq-section,
  .cta-section {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .how-section-head{
     width: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .section-head {
    margin-bottom: 0px;
    text-align: center;
    width: 100%;
    max-width: 426px;
}
.how-section-head h2{
  font-size: clamp(2.2rem, 3vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
}

  .section-head h2 {
    font-size: clamp(2.2rem, 3vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  /* ---------- STATS ---------- */
  .stats-bar { padding: 40px 16px; }

  .stats-strip {
    --ink: 35, 31, 32;
    --brand: #ff4800;
    max-width: 1084px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: #fff;
    border: 1px solid rgba(var(--ink), 0.2);
    border-radius: 24px;
    overflow: hidden;
    font-family: 'Cabin', system-ui, sans-serif;
  }

  .stat-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px;
    text-align: center;
  }

  /* dashed vertical divider (60px) */
  .stat-cell + .stat-cell::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    height: 60px;
    transform: translateY(-50%);
    border-left: 2px dashed rgba(var(--ink), 0.2);
  }
  .step-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
}
  .stat-cell strong {
    font-size: 36px;
    line-height: 44px;
    font-weight: 600;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .stat-cell span {
    font-size: 16px;
    line-height: 1.2;
    font-weight: 400;
    color: rgba(var(--ink), 0.7);
  }

  /* ---------- FEATURES ---------- */
  .feature-stack {
    display: flex;
    flex-direction: column;
    gap: 60px;
   
  }

  .feature-row {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: 34px;
    align-items: center;
  }

  .feature-row.reverse { grid-template-columns: 1.08fr 0.92fr; }

  .feature-copy { max-width: 460px; }

  .feature-copy h3 {
    font-size: clamp(2rem, 2.4vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 14px;
  }

  .feature-copy p {
    font-size: 18px;
    line-height: 1.5;
    color: var(--muted-60);
  }

  .feature-visual {
    position: relative;
    min-height: 512px;
    background: rgba(255,72,0,0.08);
    border-radius: 24px;
    border: 1px solid rgba(255,72,0,0.08);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .phone-panel {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .phone-panel-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ---------- HOW IT WORKS ---------- */
  .how-section {    
      width: 100%;
      padding: 96px 0px;
      background-color: hsl(345deg 6% 13% / 5%);
      max-width: 100%;
      display: flex;
      align-items: center;
      flex-direction: column;
      gap:80px
  }

  .steps-strip {
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: 100%;
  max-width: 1280px;
  overflow: hidden;
  border: 1px solid rgb(35 31 32 / 20%);
  border-radius: 24px;
}

.step-card {
  --line: rgba(35, 31, 32, 0.2);
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 32px;
  min-height: 270px;
  padding: 40px;
  background: #fff;
  
}

/* first card */
.step-card:first-child {
  border-right-width: 0;
  border-radius: 24px 0 0 24px;
}

/* center card */
.step-card:nth-child(2) {
  border-left-width: 0;
  border-right-width: 0;
  border-radius: 0;
}

/* last card */
.step-card:last-child {
  border-left-width: 0;
  border-radius: 0 24px 24px 0;
}

/* dashed vertical divider (150px) */
.step-card + .step-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  height: 150px;
