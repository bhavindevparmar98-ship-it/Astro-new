---
import { Image } from "astro:assets";
import "../components/styles.astro/global.css";
import appStoreBadge from "../assets/app-store-apple-logo.svg";
import googlePlayBadge from "../assets/google-play-badge-logo1.svg";
import phoneMockup from "../assets/iphone-15-pro-max-hand-mockup.png";
import heroBg from "../assets/home-hero-img.png";
import frameImg1 from "../assets/Frame img-4.svg";
import frameImg3 from "../assets/Frame img-3.svg";
import frameImg4 from "../assets/frame-img-1.svg";
import frameImg5 from "../assets/Frame img-2.svg";
import saveIcon from "../assets/Bookmark--Streamline-Carbon.svg";
import organizeIcon from "../assets/Categories--Streamline-Carbon.svg";
import remindIcon from "../assets/Mobile.svg";

import galleryImg2 from "../assets/gallery-img-2.svg";
import galleryImg3 from "../assets/gallery-img-3.png";
import galleryImg4 from "../assets/gallery-img-4.png";
import galleryImg5 from "../assets/gallery-img-5.png";
import galleryImg7 from "../assets/gallery-img-12.png";
import galleryImg8 from "../assets/gallery-img-13.png";
import galleryImg9 from "../assets/gallery-img-14.png";
import galleryImg10 from "../assets/gallery-img-15.png";
import galleryImg11 from "../assets/gallery-img-16.png";
import galleryImg12 from "../assets/gallery-img-17.png";

const slides = [
  galleryImg2,
  galleryImg3,
  galleryImg4,
  galleryImg5,
  galleryImg7,
  galleryImg8,
  galleryImg9,
  galleryImg10,
  galleryImg11,
  galleryImg12,
];
// Figma screen = 207.6 x 451.68 (2x for retina)
const PHONE_WIDTH = 416;
const PHONE_HEIGHT = 904;
// Infinite slider without Swiper's loop mode: 3 identical copies, we always
// stay inside the middle copy (see script) so left/right never run empty.
const loopSlides = [...slides, ...slides, ...slides];

const heroStats = [
  { value: "120K+", label: "Active users" },
  { value: "4.9+", label: "App Store rating" },
  { value: "8M+", label: "Items saved" },
  { value: "8+", label: "Platforms supported" },
];

const steps = [
  {
    step: "STEP 01",
    title: "Save",
    text: "Share anything to Savio in a single tap.",
    icon: "save",
  },
  {
    step: "STEP 02",
    title: "Organize",
    text: "Drop it into a collection or let us suggest one.",
    icon: "organize",
  },
  {
    step: "STEP 03",
    title: "Revisit",
    text: "Get gentle reminders and your daily digest.",
    icon: "remind",
  },
];

const testimonials = [
  {
    quote: "Savio replaced 4 apps. My screenshots folder finally has peace.",
    name: "Rhea S.",
    role: "Product designer",
  },
  {
    quote:
      "I save less and remember more. The reminder system feels calm, not noisy.",
    name: "Miles D.",
    role: "Writer",
  },
  {
    quote:
      "The collections are clean, searchable, and actually useful every single day.",
    name: "Preeti A.",
    role: "Research lead",
  },
  {
    quote:
      "It finally feels like a place for my internet life instead of a graveyard of tabs.",
    name: "Aarav N.",
    role: "Creator",
  },
];

// Only the first FAQ is open on load
const faqs = [
  {
    q: "What is Savio and how is it different from bookmarks?",
    a: "Savio is not just a place to dump links. It helps you save content with intention, organize it into collections, and come back to it with smart reminders so nothing important gets lost.",
    open: true,
  },
  {
    q: "Does Savio store everything privately?",
    a: "Yes. Savio is built to keep your saved content personal and private while still making it easy to revisit and share the things that matter.",
    open: false,
  },
  {
    q: "Can I save from mobile apps and the web?",
    a: "Absolutely. Savio works across popular apps and URLs so you can keep your saves in one place without extra effort.",
    open: false,
  },
  {
    q: "Is it free to use?",
    a: "Yes. Savio is free to download and use, with a calming, no-friction experience at the core of the product.",
    open: false,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Savio landing page" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Savio | Landing Page</title>
  </head>
  <body>
    <div class="landing-shell">
      <header class="hero-header">
        <div class="hero-frame">
          <nav class="navbar" aria-label="Main navigation">
            <a href="/landing" class="brand-mark" aria-label="Savio home">
              <img src="/savio-logo.svg" alt="Savio logo" />
            </a>

            <div class="nav-links" id="nav-links">
              <a href="#features">Features</a>
              <a href="#how-it-works">How it works</a>
              <a href="#app">App</a>
              <a href="#testimonials">Testimonials</a>
            </div>

            <div class="nav-actions">
              <button type="button" class="cta-pill">Signup</button>
              <button
                type="button"
                class="nav-toggle"
                aria-expanded="false"
                aria-controls="nav-links"
                aria-label="Open menu"
              >
                <span></span><span></span><span></span>
              </button>
            </div>
          </nav>

          <div class="hero-content">
            <div class="hero-copy">
              <h1>
                Smart <span class="accent">Reminders.</span><br />
                Save what matters.
              </h1>
              <p>
                Savio turns endless scrolling into intentional saving. Capture,
                organize and revisit content from anywhere — beautifully.
              </p>
            </div>
            <div class="store-row" aria-label="Download app badges">
              <Image
                src={appStoreBadge}
                alt="Download on the App Store"
                class="badge"
                width={161}
                height={48}
              />
              <Image
                src={googlePlayBadge}
                alt="Get it on Google Play"
                class="badge"
                width={161}
                height={48}
              />
            </div>

            <div class="hero-visual" aria-label="Savio app preview">
              <div class="hero-phone-stack">
                <Image
                  src={heroBg}
                  alt="Savio app overview"
                  class="hero-main-image"
                />
              </div>
            </div>
          </div>
        </div>
      </header>

      <main>
        <section class="stats-bar">
          <div class="stats-strip">
            {
              heroStats.map((item) => (
                <div class="stat-cell">
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                </div>
              ))
            }
          </div>
        </section>

        <section class="features-section" id="features">
          <div class="section-head center">
            <span class="eyebrow eyebrow-dark">FEATURES</span>
            <h2>A calmer way to keep what you love.</h2>
          </div>

          <div class="feature-stack">
            <article class="feature-row">
              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">SAVE IN ONE TAP</span>
                <h3>From any app, <br />straight to Savio.</h3>
                <p>
                  Hit share, choose Savio, and keep your best links, clips, and
                  ideas in one place without breaking flow.
                </p>
              </div>

              <div class="feature-visual visual-orange">
                <div class="phone-panel">
                  <Image
                    src={frameImg1}
                    alt="Feature phone preview"
                    class="phone-panel-image"
                  />
                </div>
              </div>
            </article>

            <article class="feature-row reverse">
              <div class="feature-visual visual-soft">
                <div class="phone-panel">
                  <Image
                    src={frameImg3}
                    alt="Feature phone preview"
                    class="phone-panel-image"
                  />
                </div>
              </div>

              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">ORGANIZE YOUR WORLD</span>
                <h3>Collections that actually feel yours.</h3>
                <p>
                  Group saves by mood, topic, or intent with automatic
                  organization that keeps things searchable and easy to revisit.
                </p>
              </div>
            </article>

            <article class="feature-row">
              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">DAILY DIGEST</span>
                <h3>One quiet moment, instead of a thousand.</h3>
                <p>
                  A handpicked digest of what you saved, ready when you wake up.
                  Read what matters, then close the app.
                </p>
              </div>

              <div class="feature-visual visual-soft">
                <div class="phone-panel">
                  <Image
                    src={frameImg4}
                    alt="Feature phone preview"
                    class="phone-panel-image"
                  />
                </div>
              </div>
            </article>

            <article class="feature-row reverse">
              <div class="feature-visual visual-soft">
                <div class="phone-panel">
                  <Image
                    src={frameImg5}
                    alt="Feature phone preview"
                    class="phone-panel-image"
                  />
                </div>
              </div>

              <div class="feature-copy">
                <span class="eyebrow eyebrow-dark">SMART REMINDERS</span>
                <h3>The right save, at the right moment.</h3>
                <p>
                  Savio learns when you actually read, watch and revisit — and
                  gently surfaces the right things at the right time.
                </p>
              </div>
            </article>
          </div>
        </section>

        <section class="how-section" id="how-it-works">
          <div class="how-section-head center">
            <span class="eyebrow">HOW IT WORKS</span>
            <h2>Three steps. Zero friction.</h2>
          </div>

          <div class="steps-strip">
            {
              steps.map((item) => (
                <div class="step-card">
                  <div class="icon-box">
                    {item.icon === "save" && (
                      <img src={saveIcon.src} alt="Save" />
                    )}
                    {item.icon === "organize" && (
                      <img src={organizeIcon.src} alt="Organize" />
                    )}
                    {item.icon === "remind" && (
                      <img src={remindIcon.src} alt="Remind" />
                    )}
                  </div>
                  <div class="step-content">
                    <span class="step-label">{item.step}</span>
                    <div class="step-text">
                      <h3>{item.title}</h3>
                      <p>{item.text}</p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ============ APP SHOWCASE (SWIPER) ============ -->
        <section class="showcase-section" id="app">
          <div class="phone-swiper-wrap">
            <div class="swiper phone-swiper">
              <div class="swiper-wrapper">
                {
                  loopSlides.map((src, i) => (
                    <div
                      class="swiper-slide"
                      aria-hidden={
                        Math.floor(i / slides.length) !== 1 ? "true" : undefined
                      }
                    >
                      <div class="phone-mockup">
                        <div class="phone-frame">
                          <div class="phone-screen">
                            <div class="phone-notch" aria-hidden="true" />
                            <Image
                              src={src}
                              alt="Savio app screen"
                              class="screen-image"
                              loading="eager"
                              width={PHONE_WIDTH}
                              height={PHONE_HEIGHT}
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
              <div class="phone-pagination"></div>
            </div>

            <button
              class="phone-nav phone-nav-prev"
              type="button"
              aria-label="Previous"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                ><path
                  d="M15 18l-6-6 6-6"
                  stroke="#231F20"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </button>
            <button
              class="phone-nav phone-nav-next"
              type="button"
              aria-label="Next"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                ><path
                  d="M9 18l6-6-6-6"
                  stroke="#231F20"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </button>
          </div>
        </section>

        <section class="testimonial-section" id="testimonials">
          <div class="testimonial-head">
            <span class="eyebrow">LOVED BY QUIET READERS</span>
            <h2>Built for people, not for feeds.</h2>
          </div>

          <div class="marquee-wrap">
            <div class="marquee marquee-one">
              {
                [...testimonials, ...testimonials].map((item) => (
                  <article class="testimonial-card">
                    <div class="stars" aria-label="5 star rating">
                      ★★★★★
                    </div>
                    <p>“{item.quote}”</p>
                    <div class="person-row">
                      <span class="person-badge">
                        {item.name.slice(0, 2).toUpperCase()}
                      </span>
                      <div>
                        <strong>{item.name}</strong>
                        <span>{item.role}</span>
                      </div>
                    </div>
                  </article>
                ))
              }
            </div>
            <div class="marquee marquee-two">
              {
                [...testimonials, ...testimonials].map((item) => (
                  <article class="testimonial-card">
                    <div class="stars" aria-label="5 star rating">
                      ★★★★★
                    </div>
                    <p>“{item.quote}”</p>
                    <div class="person-row">
                      <span class="person-badge">
                        {item.name.slice(0, 2).toUpperCase()}
                      </span>
                      <div>
                        <strong>{item.name}</strong>
                        <span>{item.role}</span>
                      </div>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="faq-section">
          <div class="faq-layout">
            <div class="faq-copy">
              <span class="eyebrow">FAQs</span>
              <h2>Frequently asked questions</h2>
            </div>

            <div class="faq-list">
              {
                faqs.map((item) => (
                  <div class={`faq-item ${item.open ? "open" : ""}`}>
                    <div
                      class="faq-question-row"
                      role="button"
                      tabindex="0"
                      aria-expanded={item.open ? "true" : "false"}
                    >
                      <span>{item.q}</span>
                      <span class="faq-toggle" aria-hidden="true">
                        {item.open ? "−" : "+"}
                      </span>
                    </div>
                    <p>{item.a}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        <section class="cta-section">
          <div class="cta-card">
            <div class="cta-copy">
              <h2>Your saved world, one tap away.</h2>
              <p>Free to download. Built for the people who like to revisit.</p>
              <div class="cta-social compact" aria-label="App downloads">
                <Image
                  src={appStoreBadge}
                  alt="Download on the App Store"
                  class="badge small-badge"
                  width={134}
                  height={40}
                />
                <Image
                  src={googlePlayBadge}
                  alt="Get it on Google Play"
                  class="badge small-badge"
                  width={134}
                  height={40}
                />
              </div>
            </div>

            <Image
              src={phoneMockup}
              alt="Savio phone mockup"
              class="cta-phone"
            />
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src="/savio-logo.svg" alt="Savio logo" />
          </div>

          <nav class="footer-links" aria-label="Footer navigation">
            <a href="#features">Features</a>
            <a href="#how-it-works">How it works</a>
            <a href="#app">App</a>
            <a href="#testimonials">Testimonials</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --orange: #ff4800;
    --text: #231f20;
    --muted-60: rgba(35, 31, 32, 0.6);
    --muted-70: rgba(35, 31, 32, 0.7);
    --muted-80: rgba(35, 31, 32, 0.8);
    --white: #fff;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    font-family: "Cabin", system-ui, sans-serif;
    background: #ffffff;
    color: var(--text);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  img {
    display: block;
    max-width: 100%;
  }
  a {
    text-decoration: none;
  }
  button {
    font: inherit;
  }
  h2 {
    font-weight: 600;
  }
  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .landing-shell {
    width: 100%;
    background: #fff;
    overflow-x: hidden;
  }
  .hero-header {
    padding: 16px 16px 0;
  }

  /* ---------- HERO ---------- */
  .hero-frame {
    position: relative;
    width: 100%;
    margin: 0 auto;
    border-radius: 24px;
    background: linear-gradient(
      133deg,
      rgba(255, 199, 176, 0.4) 0%,
      rgba(255, 72, 0, 0.4) 94.86%
    );
    overflow: hidden;
    min-height: 992px;
    isolation: isolate;
  }

  .hero-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("../assets/landing-hero-bg.png");
    background-repeat: no-repeat;
    background-position: center center;
    background-size: contain;
    z-index: 0;
    pointer-events: none;
  }

  /* ---------- NAVBAR ---------- */
  .navbar {
    position: relative;
    z-index: 10;
    width: min(1110px, calc(100% - 64px));
    height: 72px;
    margin: 24px auto 0;
    padding: 0 20px 0 18px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(35, 31, 32, 0.1);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 104px;
    background: none;
  }
  .brand-mark img {
    width: auto;
    height: 32px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1;
  }

  .nav-links a {
    padding: 12px 16px;
    color: var(--muted-80);
    font-size: 16px;
    line-height: 19px;
    font-weight: 400;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cta-pill {
    border: none;
    background: var(--orange);
    color: var(--white);
    border-radius: 12px;
    width: 112px;
    height: 43px;
    cursor: pointer;
    font-weight: 500;
    font-size: 16px;
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle span {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: #231f20;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }
  .nav-toggle span:nth-child(1) {
    top: 15px;
  }
  .nav-toggle span:nth-child(2) {
    top: 21px;
  }
  .nav-toggle span:nth-child(3) {
    top: 27px;
  }

  .navbar.is-open .nav-toggle span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .navbar.is-open .nav-toggle span:nth-child(2) {
    opacity: 0;
  }
  .navbar.is-open .nav-toggle span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav-toggle:focus-visible,
  .faq-question-row:focus-visible,
  .phone-nav:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  /* ---------- HERO CONTENT ---------- */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1110px;
    margin: 0 auto;
    padding: 80px 0 0;
  }

  .hero-copy {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 16px;
    line-height: 19px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .hero-copy h1 {
    font-size: 4rem;
    line-height: 100%;
    letter-spacing: -0.01em;
    font-weight: 600;
    color: var(--text);
  }

  .hero-copy h1 .accent {
    color: var(--orange);
  }

  .hero-copy p {
    max-width: 760px;
    font-size: 20px;
    line-height: 1.35;
    color: var(--muted-60);
  }

  .store-row {
    margin-top: 32px;
    display: flex;
    gap: 16px;
    flex-direction: row;
    justify-content: center;
  }

  .badge {
    width: 161.34px;
    height: 48px;
    object-fit: cover;
  }

  .badge.small-badge {
    width: 134.45px;
    height: 40px;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    margin: 0 auto;
    align-items: flex-end;
  }

  .hero-phone-stack {
    position: absolute;
    width: min(954px, 100%);
    margin: 0 auto;
    top: 24%;
    left: auto;
    right: auto;
  }

  .hero-main-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: cover;
    filter: drop-shadow(0 22px 24px rgba(35, 31, 32, 0.18));
  }

  /* ---------- SECTION WRAPPERS ---------- */
  .features-section {
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    padding: 80px 16px;
  }

  .how-section,
  .testimonial-section,
  .faq-section {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  .how-section-head {
    width: auto;
    max-width: 100%;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .section-head {
    text-align: center;
    width: 100%;
    max-width: 426px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .how-section-head h2,
  .section-head h2 {
    font-size: 3rem;
    line-height: 100%;
    color: var(--text);
  }

  /* ---------- STATS ---------- */
  .stats-bar {
    padding: 40px 16px;
  }

  .stats-strip {
    --ink: 35, 31, 32;
    --brand: #ff4800;
    max-width: 1084px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: #fff;
    border: 1px solid rgba(var(--ink), 0.2);
    border-radius: 24px;
    overflow: hidden;
  }

  .stat-cell {
    position: relative;
