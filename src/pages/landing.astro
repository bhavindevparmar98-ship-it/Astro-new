  /*
    Figma: phone 229.49 x 473, gap 40  ->  pitch = 269.49
    Slider width = 2 * m * pitch, centered on a phone, so the
    left + right edge phone is exactly 50% visible.
    --m = how many phones on each side of the center one (tune here).
  */

  .showcase-section {
    width: 100%;
    padding: 80px 0 96px;
    background: #f4f4f4;
    overflow: hidden;
    container-type: inline-size;
  }

  .phone-swiper-wrap {
    --m: 3;
    --max: 229.49px;
    --gap-ratio: 0.1743; /* 40 / 229.49 */
    --slide-w: min(
      var(--max),
      calc(100cqw / (2 * var(--m) * (1 + var(--gap-ratio))))
    );

    --pitch: calc(var(--slide-w) * (1 + var(--gap-ratio)));
    position: relative;
    width: 100%;
    overflow: hidden;
    overflow: clip;
  } 
 

  .swiper-wrapper{
    gap: 40px;
